{
  "expo": {
    "name": "surfboard-trader",
    "slug": "surfboard-trader",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "surfboardtrader",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.anonymous.surfboard-trader"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.surfboardtrader"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Surfboard Trader to use your location to find boards near you.",
          "isIosBackgroundLocationEnabled": false,
          "NSLocationWhenInUseUsageDescription": "Allow Surfboard Trader to use your location to find boards near you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos for listing surfboards for sale",
          "cameraPermission": "Allow Surfboard Trader to access your camera"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c81388ab-7cf1-47a7-a49f-8a0c9f0299f1"
      }
    }
  }
}
